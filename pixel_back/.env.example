# 将本文件复制为 .env 后填写实际值。不要提交 .env，也不要在聊天中粘贴其中的密钥。
# Docker 的 run.sh 会始终将 SNAPSHOT_DIRECTORY 覆盖为 /app/snapshots。

# -----------------------------------------------------------------------------
# 应用与网络
# -----------------------------------------------------------------------------
# development：本地 Cookie 可使用 HTTP；production：下方所有安全密钥均为必填。
APP_ENV=production
# 紧急只读开关；设为 true 会立即在后端禁用全部绘制。
CANVAS_READ_ONLY=false
# 仅当公网无法直接访问 Uvicorn 端口，且每个请求都经由可信的 Nginx/腾讯云代理时设为 true。
TRUST_PROXY_HEADERS=true
# 可访问的前端来源，多个用英文逗号分隔；必须包含协议，末尾不要加 /。
# 同时提供根域和 www 时，两个来源都必须列出；不要写结尾的 /。
ALLOWED_ORIGINS=https://pixel-asoul.club,https://www.pixel-asoul.club
SQL_ECHO=false

# -----------------------------------------------------------------------------
# PostgreSQL：使用 DATABASE_URL，或填写以下五个 POSTGRES_* 配置之一。
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=pixel_user
POSTGRES_PASSWORD=
POSTGRES_DB=pixel_canvas
# DATABASE_URL 非空时优先使用；密码中的特殊字符需要进行 URL 编码。
# DATABASE_URL=postgresql+asyncpg://pixel_user:password@127.0.0.1:5432/pixel_canvas

# -----------------------------------------------------------------------------
# 画布与快照
# -----------------------------------------------------------------------------
CANVAS_WIDTH=1000
CANVAS_HEIGHT=1000
# 本地默认目录为 snapshots。Docker 会将部署目录的 snapshots/ 挂载到
# /app/snapshots，并覆盖本项配置。
SNAPSHOT_DIRECTORY=snapshots
# 用户绘制或管理员恢复累计提交达到此数量后创建快照。
# 项目刻意不使用按时间触发的快照间隔。
SNAPSHOT_THRESHOLD=250

# -----------------------------------------------------------------------------
# WebSocket 消息发送
# -----------------------------------------------------------------------------
WS_MAX_MESSAGE_BYTES=4096
WS_SEND_TIMEOUT_SECONDS=2
WS_CONNECTION_QUEUE_SIZE=256
DISPATCHER_QUEUE_SIZE=10000

# -----------------------------------------------------------------------------
# 匿名访客与管理员安全
# 生成 VISITOR_COOKIE_SECRET、ADMIN_SESSION_SECRET：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# 从管理员原始令牌生成 ADMIN_TOKEN_HASH：
# python -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
# -----------------------------------------------------------------------------
# 生产环境必填；仅用于签名有效期 90 天的 HttpOnly 匿名访客 Cookie。
VISITOR_COOKIE_SECRET=
VISITOR_COOKIE_DAYS=90
# 生产环境必填；高强度管理员令牌的 SHA-256 摘要。
ADMIN_TOKEN_HASH=
# 生产环境必填；用于签名有效期 30 分钟的 HttpOnly 管理员会话。
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MINUTES=30

# -----------------------------------------------------------------------------
# 匿名反破坏策略
# 首次部署后建议保持 observe 至少七天，结合日志和管理数据评估后再切换为 enforce。
# 两种模式都会启用 WebSocket 消息洪泛防护。
# -----------------------------------------------------------------------------
ABUSE_MODE=observe
WS_BUCKET_CAPACITY=40
WS_BUCKET_REFILL_PER_SECOND=10
VISITOR_BUCKET_CAPACITY=12
VISITOR_BUCKET_REFILL_PER_SECOND=3
IP_BUCKET_CAPACITY=120
IP_BUCKET_REFILL_PER_SECOND=30
OVERWRITE_BUCKET_CAPACITY=20
OVERWRITE_REFILL_SECONDS=15
# 同一匿名访客在某坐标最后一次用户修改后的这段时间内再次修改，
# 视为本人继续调整：不消耗覆盖预算，也不计入覆盖风险；仍受消息、访客和 IP 限速。
# 设为 3600 即 1 小时。管理员恢复和他人最后修改的像素不享受此宽限。
SELF_EDIT_GRACE_SECONDS=3600
# 验证码成功后仍持续耗尽覆盖预算时的观察与处置：
# 在前者分钟内再次耗尽覆盖预算，直接禁画后者分钟，而不是再次要求验证码。
VERIFIED_RISK_WINDOW_MINUTES=10
VERIFIED_RISK_BLOCK_MINUTES=30

# -----------------------------------------------------------------------------
# 腾讯云验证码：未配置验证码应用前，以下四项可保留为空。
# 在腾讯云创建“Web/H5”验证并配置生产前端域名后，填写对应凭证。
# 前端会按需加载腾讯验证码脚本；以下密钥只用于服务端校验票据，绝不能写入前端代码。
# -----------------------------------------------------------------------------
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_APP_SECRET_KEY=
